# Local development: point at any Postgres instance.
# On Netlify, DATABASE_URL is wired automatically from NETLIFY_DB_URL
# (Netlify Database), which the platform injects for builds and the
# server runtime — see netlify.toml and netlify/server/index.mjs.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/led_mfg_db?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
